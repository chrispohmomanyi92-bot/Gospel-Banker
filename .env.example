PORT=3000
# Long random string; keeps people signed in across restarts
JWT_SECRET=replace-with-a-long-random-string
# Password for the built-in "admin" account (only used the first time the database is created)
ADMIN_PASSWORD=choose-a-strong-password
# Optional: turns on the AI abusive-language filter (Claude). Without it the local word filter still runs.
ANTHROPIC_API_KEY=
DB_PATH=./data/gospel-banker.db
